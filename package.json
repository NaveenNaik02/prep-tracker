{
  "name": "interview-topics-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "sh -c 'set -a && . ./.env.local.docker && set +a && next dev'",
    "dev:remote": "DEV_REMOTE=1 next dev -p 3010",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:studio": "curl -sf --max-time 2 -o /dev/null http://127.0.0.1:54323 && echo 'Supabase Studio → http://127.0.0.1:54323' && open http://127.0.0.1:54323 || { echo 'Nothing on :54323. Either the stack is down (pnpm db:start), or Studio is disabled in supabase/config.toml (set [studio] enabled = true, then pnpm db:stop && pnpm db:start). To browse data without it: pnpm db:psql'; exit 1; }",
    "db:schema": "sh scripts/db-schema.sh",
    "db:psql": "docker exec -i $([ -t 0 ] && printf %s -t) supabase_db_interview psql -U postgres -d postgres",
    "build": "next build",
    "start": "next start",
    "migrate": "node --env-file=.env.local scripts/migrate.js",
    "set-admin": "node --env-file=.env.local scripts/set-admin.js",
    "pull-remote": "node --env-file=.env.local scripts/pull-remote.js",
    "lint": "eslint .",
    "test": "vitest run",
    "//skills:install": "Restores third-party agent skills from skills-lock.json. Their content is gitignored (only the lockfile is committed), so run this after a fresh clone or whenever skills-lock.json changes.",
    "skills:install": "pnpm dlx skills experimental_install"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^0.400.0",
    "marked": "^18.0.6",
    "next": "^16.2.4",
    "prismjs": "^1.30.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20.14.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.14",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "jsdom": "26.1.0"
  }
}
